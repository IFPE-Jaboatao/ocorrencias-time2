# ══════════════════════════════════════════════════════════════════════════════
#  Radar Acadêmico — Variáveis de Ambiente de PRODUÇÃO
#  Copie para .env e preencha todos os valores marcados com ← PREENCHER
#
#  NUNCA commite o .env com valores reais.
#  Use: cp .env.production.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ─── Banco de Dados ────────────────────────────────────────────────────────────
# DB_HOST é sobrescrito para 'db' pelo docker-compose.prod.yml
DB_HOST=db
DB_PORT=3306
DB_NAME=sgoa
DB_USER=sgoa_user
DB_PASS=                          # ← PREENCHER — senha forte (≥ 20 chars, sem @#$%&)
DB_ROOT_PASS=                     # ← PREENCHER — senha root diferente do DB_PASS

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 64
JWT_SECRET=                       # ← PREENCHER (128 hex chars)
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Magic Link ────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 64
MAGIC_LINK_SECRET=                # ← PREENCHER (128 hex chars, DIFERENTE do JWT_SECRET)
MAGIC_LINK_BASE_URL=              # ← PREENCHER — ex: https://radar.escola.edu.br
MAGIC_LINK_TTL_MINUTES=15

# ─── Sessão ────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_HOURS=8

# ─── Criptografia ──────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
# ATENÇÃO: perder esta chave = perder acesso a todos os CPFs criptografados
ENCRYPTION_KEY=                   # ← PREENCHER (64 hex chars)

# ─── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=                       # ← PREENCHER — ex: us-east-1, sa-east-1
AWS_S3_BUCKET=                    # ← PREENCHER — nome do bucket (ex: radar-academico-evidencias)
AWS_ACCESS_KEY_ID=                # ← PREENCHER — IAM user com permissão só neste bucket
AWS_SECRET_ACCESS_KEY=            # ← PREENCHER
S3_PRESIGNED_TTL_SECONDS=900

# ─── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Use SMTP institucional ou serviço transacional (SendGrid, SES, Mailgun)
SMTP_HOST=                        # ← PREENCHER — ex: smtp.escola.edu.br
SMTP_PORT=587
SMTP_SECURE=false                 # true apenas para porta 465
EMAIL_FROM=                       # ← PREENCHER — ex: noreply@escola.edu.br
EMAIL_USER=                       # ← PREENCHER
EMAIL_PASS=                       # ← PREENCHER

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=                     # ← PREENCHER — ex: https://radar.escola.edu.br

# ─── Dev tools — OBRIGATORIAMENTE false em produção ───────────────────────────
DEV_LOGIN_ENABLED=false
SWAGGER_ENABLED=false

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Injetada em BUILD TIME no bundle do Next.js (ARG no Dockerfile).
# Deve ser o endereço público da API visto pelo navegador.
NEXT_PUBLIC_API_URL=              # ← PREENCHER — ex: https://radar.escola.edu.br

# ─── Monitoramento (Sentry) ────────────────────────────────────────────────────
SENTRY_DSN=                       # ← PREENCHER — obtido em sentry.io (opcional mas recomendado)

# ─── Banco de teste (CI/CD) ────────────────────────────────────────────────────
# Usado apenas no pipeline de CI — nunca em produção
TEST_DB_NAME=sgoa_test
